{
  "$schema": "https://jangalinski.github.io/tabweb/navigation.schema.json",
  "version": 1,
  "root": [
    {
      "name": "Home",
      "description": "Documentation and things",
      "route": "/",
      "icon": "TI_HOME"
    },
    {
      "name": "Interface",
      "route": "/interface",
      "icon": "TI_BOX",
      "children": [
        {
          "name": "Avatars",
          "description": "Avatars display a photo, icon, or initials to represent a person, brand, or status.",
          "route": "/interfaces/avatars"
        },
        {
          "name": "Badges",
          "description": "Badges highlight statuses, counts, and categories with a compact Tabler label.",
          "route": "/interfaces/badges"
        },
        {
          "name": "Buttons",
          "description": "Buttons invoke user actions with Tabler colors, sizes, shapes, and icons.",
          "route": "/interfaces/buttons"
        },
        {
          "name": "Cards",
          "description": "Cards are flexible and extensible content containers with multiple variants and options.",
          "route": "/interfaces/cards"
        },
        {
          "name": "Extreme cards",
          "description": "Stress tests for combinations of card DSL options.",
          "route": "/interfaces/extreme-cards"
        },
        {
          "name": "Charts",
          "description": "Chart examples rendered in Tabler cards with ApexCharts.",
          "route": "/interfaces/charts",
          "children": [
            {
              "name": "Chart gallery",
              "description": "Chart examples rendered in Tabler cards with ApexCharts.",
              "route": "/interfaces/charts"
            },
            {
              "name": "Bar charts",
              "description": "The first chart family to receive a typed ApexCharts specification.",
              "route": "/interfaces/charts/bar"
            }
          ]
        },
        {
          "name": "Colors",
          "description": "The full color palette, with hex values, and a gradient builder.",
          "route": "/interfaces/colors"
        },
        {
          "name": "Tables",
          "description": "Tables display information in a grid-like format of rows and columns.",
          "route": "/interfaces/tables"
        }
      ]
    },
    {
      "name": "Infrastructure",
      "route": "/infrastructure",
      "icon": "TI_SERVER",
      "children": [
        {
          "name": "Components",
          "description": "Reusable UI building blocks",
          "route": "/components"
        },
        {
          "name": "Empty",
          "description": "an empty page",
          "route": "/empty"
        },
        {
          "name": "Elements",
          "description": "Low-level Tabler elements",
          "route": "/elements"
        }
      ]
    },
    {
      "name": "Plugins",
      "route": "/plugins",
      "icon": "TI_PUZZLE",
      "columns": 2,
      "children": [
        {
          "name": "Markdown pages",
          "route": "/markdown-pages",
          "sections": [
            {
              "name": "Tabweb",
              "elements": [
                {
                  "name": "Markdown pages",
                  "route": "/markdown-pages"
                },
                {
                  "name": "Components",
                  "route": "/components",
                  "children": [
                    {
                      "name": "Avatars",
                      "route": "/interfaces/avatars"
                    },
                    {
                      "name": "Badges",
                      "route": "/interfaces/badges"
                    },
                    {
                      "name": "Buttons",
                      "route": "/interfaces/buttons"
                    },
                    {
                      "name": "Cards",
                      "route": "/interfaces/cards"
                    },
                    {
                      "name": "Tables",
                      "route": "/interfaces/tables"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "Marketplace",
          "route": "/plugins/marketplace"
        },
        {
          "name": "Installed",
          "route": "/plugins/installed",
          "children": [
            {
              "name": "Analytics",
              "route": "/plugins/installed/analytics"
            },
            {
              "name": "Backups",
              "route": "/plugins/installed/backups"
            },
            {
              "name": "Monitoring",
              "route": "/plugins/installed/monitoring"
            }
          ]
        },
        {
          "name": "Updates",
          "route": "/plugins/updates"
        },
        {
          "name": "Plugin settings",
          "route": "/plugins/settings"
        },
        {
          "name": "Developer tools",
          "route": "/plugins/developer-tools"
        }
      ]
    },
    {
      "name": "Help",
      "description": "Documentation and support",
      "route": "/help",
      "icon": "TI_HELP_CIRCLE"
    }
  ]
}
