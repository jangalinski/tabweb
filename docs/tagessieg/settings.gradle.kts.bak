pluginManagement {
  repositories {
    gradlePluginPortal()
    mavenCentral()
    google()
  }

  // Make the build-logic composite available as a plugin source for `plugins {}` resolution.
  includeBuild("../gradle/build-logic")
}

dependencyResolutionManagement {
  repositories {
    mavenCentral()
    google()
    maven {
      url = uri("https://jitpack.io")
    }
  }

  // `site` is its own Gradle build, so it needs to import the shared version catalog explicitly.
  versionCatalogs {
    create("libs") {
      from(files("../gradle/libs.versions.toml"))
    }
  }
}

rootProject.name = "tabweb-examples"

include(":tagessieg")

includeBuild("../") {
  dependencySubstitution {
    substitute(module("com.github.jangalinski:tabweb")).using(project(":lib"))
  }
}
